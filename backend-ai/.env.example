# ==========================================
# BACKEND AI (Python / Gemma 4) - ENVIRONMENT TEMPLATE
# Preencha os valores antes de executar
# ==========================================

# --- AMBIENTE & DOCKER NETWORK ---
DOCKER_NETWORK=omnichannel-network

# --- INTEGRAÇÃO LLM / OLLAMA ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b

# --- STREAMING & BUSCA ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ELASTICSEARCH_URL=http://elasticsearch:9200
AI_EVENTS_TOPIC=ai.events

# --- SEGURANÇA & CORS ---
AI_SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:8088
