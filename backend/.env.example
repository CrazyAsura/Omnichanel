# ==========================================
# OMNICHANNEL PLATFORM - BACKEND ENVIRONMENT TEMPLATE
# Valores vazios para preenchimento
# ==========================================

# --- AMBIENTE & DOCKER NETWORK ---
APP_ENV=
NODE_ENV=
SPRING_PROFILES_ACTIVE=
DOCKER_NETWORK=omnichannel-network

# --- PORTAS DOS SERVIÇOS ---
FRONTEND_PORT=
BACKEND_PORT=
BACKEND_GRPC_PORT=
AI_HTTP_PORT=
AI_GRPC_PORT=
SQLSERVER_PORT=
REDIS_PORT=
KAFKA_PORT=
KAFKA_EXTERNAL_PORT=
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=
ELASTICSEARCH_PORT=
KIBANA_PORT=
CHROMADB_PORT=
PROMETHEUS_PORT=
GRAFANA_PORT=

# --- BANCO DE DADOS (SQL SERVER) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_PASSWORD=
APP_DB_USERNAME=
APP_DB_PASSWORD=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# --- REDIS (CACHE & SESSÕES) ---
REDIS_HOST=
REDIS_PASSWORD=

# --- MENSAJERIA (KAFKA & RABBITMQ) ---
KAFKA_BOOTSTRAP_SERVERS=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- BUSCA & VETORES (ELASTICSEARCH & CHROMA) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_HOSTS=
CHROMADB_HOST=

# --- INTELIGÊNCIA ARTIFICIAL (GEMMA 4 / AGENTSCOPE) ---
AI_SERVICE_TOKEN=
AI_EVENTS_TOPIC=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- SEGURANÇA & AUTENTICAÇÃO (JWT & AUDITORIA) ---
JWT_ISSUER_URI=
JWT_JWK_SET_URI=
JWT_AUDIENCE=omnichannel-api
SECURITY_AUDIT_RETENTION_DAYS=365

# --- OBSERVABILIDADE (GRAFANA) ---
GF_SECURITY_ADMIN_USER=
GRAFANA_PASSWORD=

# --- FRONTEND & INTEGRAÇÃO DE REDE ---
FRONTEND_ORIGIN=http://localhost:8088
NEXT_PUBLIC_API_URL=http://localhost:8088
INTERNAL_BACKEND_URL=http://app:8080
